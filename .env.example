# ==============================================================================
# AcquireMock v2.0 - Environment Configuration
# Copy this file to .env and replace all placeholder secrets before starting.
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & Secrets (REQUIRED)
# ------------------------------------------------------------------------------
# Distinct cryptographically random strings of at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace-with-random-webhook-secret-at-least-32-chars
SESSION_SECRET=replace-with-random-session-secret-distinct-and-32-chars

# Administrator authentication for /app/* Developer Console and /api/console/*.
# If ADMIN_USERNAME or ADMIN_PASSWORD_HASH is unset, admin login and all
# console routes fail closed with HTTP 503.
# Generate hash with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt(12)).decode())"
# Example hash below corresponds to local development password: acquiremock-dev-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2b$12$i/bda5DB0i74vSubiIswMe6rBh9Ft4wVxieTuJbTo.PgMYHvzovC.'

# Session lifetimes (seconds)
ADMIN_SESSION_TTL_SECONDS=28800
CUSTOMER_SESSION_TTL_SECONDS=604800

# Cookie security (set HTTPS_ONLY=true behind TLS in production)
HTTPS_ONLY=false
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Application & Runtime
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=false
TESTING=false
APP_HOST=http://localhost:8000
PORT=8000
WORKERS=2

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# ------------------------------------------------------------------------------
# Database & Migrations
# ------------------------------------------------------------------------------
# SQLite (single-node / local development):
DATABASE_URL=sqlite+aiosqlite:///./acquiremock.db
# PostgreSQL (recommended for Docker / production):
# DATABASE_URL=postgresql+asyncpg://acquiremock:acquiremock@db:5432/acquiremock_db

# ------------------------------------------------------------------------------
# Currency & Payment Lifecycle
# ------------------------------------------------------------------------------
# Monetary amounts are always passed and stored as integers in minor units
# (for example, 25000 USD = $250.00, 1000 JPY = ¥1,000, 1500 KWD = 1.500 KWD).
CURRENCY_CODE=USD
CURRENCY_SYMBOL=$
PAYMENT_TTL_MINUTES=15

# ------------------------------------------------------------------------------
# Webhooks & Background Worker
# ------------------------------------------------------------------------------
# SSRF protection: keep false in production. Set true only when testing local
# webhook receivers on localhost / private networks during local development.
ALLOW_LOCAL_WEBHOOKS=false

# Webhook delivery & backoff schedule (10s, 20s, 40s, 80s for 5 attempts total)
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_SECONDS=10

# Background worker mode:
# Keep false when running the dedicated worker process (`python -m app.worker`
# or the `worker` service in Docker Compose). Set true only for single-process
# local development convenience.
ENABLE_EMBEDDED_WORKER=false

# ------------------------------------------------------------------------------
# Optional SMTP / Email Notifications (Receipts & OTPs)
# When SMTP_HOST is empty, OTP codes and email notices are logged to stdout
# only when non-sensitive fallback is enabled in development.
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@acquiremock.local
SMTP_USE_TLS=true

# Links:
# Documentation: https://github.com/ashfromsky/acquiremock/tree/main/docs
# Issues: https://github.com/ashfromsky/acquiremock/issues
# Discussions: https://github.com/ashfromsky/acquiremock/discussions
